@using System.Globalization
@{
    ViewData["Title"] = "Milan 2-1 Roma | Maç Detayı";
    ViewData["BodyClass"] = "match-page";

    var inv = CultureInfo.InvariantCulture;

    // ---- Maç verisi (gerçek projede ViewModel'den gelir) ----
    var home = new Team("home", "Milan", "MIL", "crest-milan");
    var away = new Team("away", "Roma", "ROM", "crest-roma");
    var teams = new[] { home, away };
    Team TeamOf(string side) => side == "home" ? home : away;

    var date = "18 Kasım 2026"; var time = "22:45"; var stadium = "San Siro";
    var referee = "Daniele Orsato"; var attendance = "72.145";

    // Kind: goal | yellow | red | sub. Meta: olay açıklaması (değişiklikte çıkan oyuncu)
    var events = new List<Ev>
    {
        new(14, "14'",   "home", "goal",   "Rafael Leão",       "Gol, asist: Theo Hernández",           "Theo Hernández"),
        new(27, "27'",   "away", "yellow", "Paulo Dybala",      "Sarı kart, faul"),
        new(41, "41'",   "home", "goal",   "Olivier Giroud",    "Gol, kafa, asist: Rafael Leão",        "Rafael Leão"),
        new(54, "54'",   "away", "yellow", "Bryan Cristante",   "Sarı kart, taktik faul"),
        new(58, "58'",   "away", "sub",    "Lorenzo Pellegrini","Stephan El Shaarawy"),
        new(64, "64'",   "home", "sub",    "Christian Pulisic", "Samuel Chukwueze"),
        new(67, "67'",   "home", "yellow", "Fikayo Tomori",     "Sarı kart, faul"),
        new(72, "72'",   "away", "goal",   "Tammy Abraham",     "Gol, asist: Lorenzo Pellegrini",       "Lorenzo Pellegrini"),
        new(74, "74'",   "away", "yellow", "Gianluca Mancini",  "Sarı kart, itiraz"),
        new(78, "78'",   "home", "sub",    "Yunus Musah",       "Ruben Loftus-Cheek"),
        new(79, "79'",   "away", "sub",    "Andrea Belotti",    "Tammy Abraham"),
        new(83, "83'",   "home", "yellow", "Theo Hernández",    "Sarı kart, oyunu geciktirme"),
        new(88, "88'",   "home", "sub",    "Noah Okafor",       "Rafael Leão"),
        new(92, "90+2'", "away", "red",    "Diego Llorente",    "Kırmızı kart, gol şansını engelleme"),
    };

    // İstatistikler: etiket, ev, dep, ev metni, dep metni, soluk satır mı
    var possHome = 54; var possAway = 46;
    var stats = new List<Stat>
    {
        new("Şut",          15,  10,  "15",  "10",  false),
        new("İsabetli şut", 7,   4,   "7",   "4",   false),
        new("Pas",          512, 438, "512", "438", false),
        new("Pas isabeti",  87,  82,  "%87", "%82", false),
        new("Korner",       6,   4,   "6",   "4",   false),
        new("Faul",         11,  13,  "11",  "13",  true),
        new("Ofsayt",       2,   1,   "2",   "1",   true),
        new("Sarı kart",    2,   3,   "2",   "3",   true),
        new("Kırmızı kart", 0,   1,   "0",   "1",   true),
    };

    // ---- Türetilen değerler ----
    int Goals(string side, int maxMin = 999) => events.Count(e => e.Kind == "goal" && e.Side == side && e.Min <= maxMin);
    var hg = Goals("home"); var ag = Goals("away");
    var hht = Goals("home", 45); var aht = Goals("away", 45);

    string Anchor(Ev e) => "ev-" + e.Label.Split('+')[0].TrimEnd('\'');
    string MinText(Ev e) => e.Label.TrimEnd('\'');
    string KindGroup(Ev e) => e.Kind is "yellow" or "red" ? "card" : e.Kind;
    string Leader(int h, int a) => h > a ? home.Name + " önde" : a > h ? away.Name + " önde" : "Beraberlik";
    string Pct(double h, double a, bool isHome)
    {
        var total = h + a;
        var v = total == 0 ? 50 : (isHome ? h : a) / total * 100;
        if (v <= 0) return "0%";
        if (v >= 100) return "100%";
        return "calc(" + v.ToString("0.#", inv) + "% - 2px)";
    }
    string MarkerAria(Ev e) => e.Kind switch
    {
        "goal" => $"{MinText(e)}. dakika, {TeamOf(e.Side).Name} golü, {e.Player}",
        "yellow" => $"{MinText(e)}. dakika, sarı kart, {e.Player}",
        "red" => $"{MinText(e)}. dakika, kırmızı kart, {e.Player}",
        _ => $"{MinText(e)}. dakika, {TeamOf(e.Side).Name} oyuncu değişikliği"
    };
    string MarkerTitle(Ev e) => e.Kind switch
    {
        "goal" => $"{e.Label} Gol: {e.Player}",
        "yellow" => $"{e.Label} Sarı kart: {e.Player}",
        "red" => $"{e.Label} Kırmızı kart: {e.Player}",
        _ => $"{e.Label} Değişiklik: {e.Player} girdi"
    };
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/match-detail.css" asp-append-version="true" />
}

@* Not: Bootstrap 5 CSS (container-xl, row, col-*) _Layout içinde yüklü olmalı. *@

<!-- SVG sembolleri -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="i-ball" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 7.4l3.4 2.5-1.3 4h-4.2l-1.3-4z" fill="currentColor" /><path d="M12 3v4.4M20.5 9.3l-5.1.6M17.4 19.4l-3.3-5.5M6.6 19.4l3.3-5.5M3.5 9.3l5.1.6" fill="none" stroke="currentColor" stroke-width="1.4" /></symbol>
    <symbol id="i-swap" viewBox="0 0 24 24"><path d="M7 4v14M3.5 7.5L7 4l3.5 3.5M17 20V6M13.5 16.5L17 20l3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></symbol>
    <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M3.5 10h17M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></symbol>
    <symbol id="i-stadium" viewBox="0 0 24 24"><ellipse cx="12" cy="9" rx="9" ry="3.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M3 9v6c0 1.9 4 3.5 9 3.5s9-1.6 9-3.5V9" fill="none" stroke="currentColor" stroke-width="1.8" /></symbol>
    <symbol id="i-whistle" viewBox="0 0 24 24"><circle cx="9" cy="14" r="5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12.5 10.5L21 6v4l-5.5 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></symbol>
</svg>

<main class="match-shell container-xl" data-match>

    <header class="match-hero">
        <div class="hero-topbar">
            <ul class="comp-tags" aria-label="Müsabaka">
                <li class="comp-tag comp-tag--league">Serie A</li>
                <li class="comp-tag">2026/27</li>
                <li class="comp-tag">Hafta 12</li>
            </ul>
            <span class="status-pill">Maç bitti</span>
        </div>

        <div class="scoreboard">
            <div class="sb-team sb-team--home @(hg < ag ? "is-loser" : "")">
                <span class="team-crest team-crest--xl @home.Css" aria-hidden="true">@home.Abbr</span>
                <div>
                    <span class="sb-team__role">Ev sahibi</span>
                    <h1 class="sb-team__name">@home.Name</h1>
                    <ul class="sb-scorers" aria-label="@home.Name golleri">
                        @foreach (var e in events.Where(x => x.Kind == "goal" && x.Side == "home"))
                        {
                            <li><svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>@e.Player @e.Label</li>
                        }
                    </ul>
                </div>
            </div>

            <div class="sb-score">
                <p class="sb-score__value" aria-label="Skor: @home.Name @hg, @away.Name @ag">
                    <span class="@(hg < ag ? "is-loser" : "")">@hg</span><span class="sb-score__sep" aria-hidden="true"></span><span class="@(ag < hg ? "is-loser" : "")">@ag</span>
                </p>
                <p class="sb-score__ht">İlk yarı @hht-@aht</p>
            </div>

            <div class="sb-team sb-team--away @(ag < hg ? "is-loser" : "")">
                <span class="team-crest team-crest--xl @away.Css" aria-hidden="true">@away.Abbr</span>
                <div>
                    <span class="sb-team__role">Deplasman</span>
                    <h2 class="sb-team__name">@away.Name</h2>
                    <ul class="sb-scorers" aria-label="@away.Name golleri">
                        @foreach (var e in events.Where(x => x.Kind == "goal" && x.Side == "away"))
                        {
                            <li><svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>@e.Player @e.Label</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <ul class="hero-facts">
            <li><svg aria-hidden="true"><use href="#i-calendar" /></svg>@date</li>
            <li><svg aria-hidden="true"><use href="#i-clock" /></svg>@time</li>
            <li><svg aria-hidden="true"><use href="#i-stadium" /></svg>@stadium</li>
            <li><svg aria-hidden="true"><use href="#i-whistle" /></svg><span>Hakem:</span> @referee</li>
        </ul>

        <section class="flow-strip" aria-labelledby="flow-title">
            <div class="flow-head">
                <h2 class="flow-title" id="flow-title">Maç akışı</h2>
                <p class="flow-hint">Ayrıntısını görmek için bir olaya dokun</p>
            </div>
            <div class="flow-scroll">
                <div class="flow-track">
                    <span class="flow-side-label flow-side-label--home"><span class="team-crest team-crest--xs @home.Css" aria-hidden="true">@home.Abbr</span></span>
                    <span class="flow-side-label flow-side-label--away"><span class="team-crest team-crest--xs @away.Css" aria-hidden="true">@away.Abbr</span></span>
                    <span class="flow-axis" aria-hidden="true"></span>
                    <span class="flow-half" aria-hidden="true"><span>Devre arası</span></span>
                    @foreach (var tick in new[] { 15, 30, 45, 60, 75, 90 })
                    {
                        <span class="flow-tick" style="--x:calc(@tick / 95 * 100%)">@tick'</span>
                    }

                    @foreach (var e in events)
                    {
                        // Aynı tarafta 2 dakika içinde ardışık olaylar üst üste binmesin
                        var nudge = events.Any(o => o != e && o.Side == e.Side && e.Min - o.Min > 0 && e.Min - o.Min <= 2);
                        <button type="button"
                                class="flow-marker flow-marker--@e.Side flow-marker--@KindGroup(e)"
                                style="--m:@e.Min@(nudge ? ";margin-left:7px" : "")"
                                data-flow-ref="@Anchor(e)"
                                aria-label="@MarkerAria(e)" title="@MarkerTitle(e)">
                            <span class="flow-marker__dot">
                                @if (e.Kind == "goal")
                                {
                                    <svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>
                                }
                                else if (e.Kind is "yellow" or "red")
                                {
                                    <span class="i-card i-card--@e.Kind"></span>
                                }
                            </span>
                        </button>
                    }
                </div>
            </div>
        </section>
    </header>

    <div class="match-body">
        <div class="row g-4">

            <div class="col-lg-8">

                <section class="panel" aria-labelledby="timeline-title">
                    <div class="panel__head">
                        <h2 class="panel__title" id="timeline-title">Maç olayları</h2>
                        <div class="event-filter" role="group" aria-label="Olay türüne göre filtrele">
                            <button type="button" class="chip" data-event-filter="all" aria-pressed="true">Tümü</button>
                            <button type="button" class="chip" data-event-filter="goal" aria-pressed="false">Goller</button>
                            <button type="button" class="chip" data-event-filter="card" aria-pressed="false">Kartlar</button>
                            <button type="button" class="chip" data-event-filter="sub" aria-pressed="false">Değişiklikler</button>
                        </div>
                    </div>

                    <div class="timeline-legend" aria-hidden="true">
                        <span><span class="team-crest team-crest--xs @home.Css">@home.Abbr</span>@home.Name</span>
                        <span></span>
                        <span>@away.Name<span class="team-crest team-crest--xs @away.Css">@away.Abbr</span></span>
                    </div>

                    <ol class="timeline">
                        <li class="event event--period"><span class="period-mark">Başlama düdüğü</span></li>

                        @{
                            var runH = 0; var runA = 0; var halfShown = false;
                        }
                        @foreach (var e in events)
                        {
                            if (!halfShown && e.Min > 45)
                            {
                                halfShown = true;
                                <li class="event event--period"><span class="period-mark">Devre arası <strong>@hht-@aht</strong></span></li>
                            }
                            if (e.Kind == "goal")
                            {
                                if (e.Side == "home") { runH++; } else { runA++; }
                            }
                            <li class="event event--@e.Side event--@e.Kind" id="@Anchor(e)" data-type="@KindGroup(e)">
                                <span class="event__minute">@e.Label</span>
                                <div class="event-card">
                                    <span class="event-card__icon">
                                        @if (e.Kind == "goal")
                                        {
                                            <svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>
                                        }
                                        else if (e.Kind == "sub")
                                        {
                                            <svg width="18" height="18" aria-hidden="true"><use href="#i-swap" /></svg>
                                        }
                                        else
                                        {
                                            <span class="i-card i-card--@e.Kind"></span>
                                        }
                                    </span>
                                    <span class="event-card__body">
                                        @if (e.Kind == "sub")
                                        {
                                            <span class="event-card__player sub-in">@e.Player</span>
                                            <span class="event-card__meta sub-out">@e.Meta</span>
                                        }
                                        else
                                        {
                                            <span class="event-card__player">@e.Player</span>
                                            <span class="event-card__meta">@e.Meta</span>
                                        }
                                    </span>
                                    @if (e.Kind == "goal")
                                    {
                                        <span class="event-score">@runH-@runA</span>
                                    }
                                </div>
                            </li>
                        }

                        <li class="event event--period"><span class="period-mark">Maç sonu <strong>@hg-@ag</strong></span></li>
                    </ol>
                </section>

                <section class="panel" aria-labelledby="goals-title">
                    <div class="panel__head"><h2 class="panel__title" id="goals-title">Goller</h2></div>
                    <div class="split">
                        @foreach (var t in teams)
                        {
                            var list = events.Where(e => e.Kind == "goal" && e.Side == t.Side).ToList();
                            <div class="split__col">
                                <h3 class="split__team"><span class="team-crest team-crest--xs @t.Css" aria-hidden="true">@t.Abbr</span>@t.Name<span class="split__count">@list.Count gol</span></h3>
                                @if (list.Count == 0)
                                {
                                    <p class="item-empty">Gol yok</p>
                                }
                                else
                                {
                                    <ul class="item-list goal-list">
                                        @foreach (var e in list)
                                        {
                                            <li><span class="item-minute">@e.Label</span><span class="item-main"><strong>@e.Player</strong><small>Asist: @e.Assist</small></span></li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="panel" aria-labelledby="cards-title">
                    <div class="panel__head"><h2 class="panel__title" id="cards-title">Kartlar</h2></div>
                    <div class="split">
                        @foreach (var t in teams)
                        {
                            var list = events.Where(e => e.Kind is "yellow" or "red" && e.Side == t.Side).ToList();
                            <div class="split__col">
                                <h3 class="split__team"><span class="team-crest team-crest--xs @t.Css" aria-hidden="true">@t.Abbr</span>@t.Name<span class="split__count">@list.Count kart</span></h3>
                                @if (list.Count == 0)
                                {
                                    <p class="item-empty">Kart yok</p>
                                }
                                else
                                {
                                    <ul class="item-list">
                                        @foreach (var e in list)
                                        {
                                            <li>
                                                <span class="item-minute">@e.Label</span>
                                                <span class="item-main"><strong>@e.Player</strong></span>
                                                <span class="card-tag"><span class="i-card i-card--@e.Kind"></span>@(e.Kind == "red" ? "Kırmızı" : "Sarı")</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="panel" aria-labelledby="subs-title">
                    <div class="panel__head"><h2 class="panel__title" id="subs-title">Oyuncu değişiklikleri</h2></div>
                    <div class="split">
                        @foreach (var t in teams)
                        {
                            var list = events.Where(e => e.Kind == "sub" && e.Side == t.Side).ToList();
                            <div class="split__col">
                                <h3 class="split__team"><span class="team-crest team-crest--xs @t.Css" aria-hidden="true">@t.Abbr</span>@t.Name<span class="split__count">@list.Count değişiklik</span></h3>
                                @if (list.Count == 0)
                                {
                                    <p class="item-empty">Değişiklik yok</p>
                                }
                                else
                                {
                                    <ul class="item-list">
                                        @foreach (var e in list)
                                        {
                                            <li><span class="item-minute">@e.Label</span><span class="item-main"><strong class="sub-in">@e.Player</strong><small class="sub-out">@e.Meta</small></span></li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                </section>
            </div>

            <aside class="col-lg-4 side-col" aria-label="Maç özeti ve istatistikler">

                <div class="period-cards">
                    <article class="period-card">
                        <p class="period-card__label">İlk yarı</p>
                        <p class="period-card__score">@hht-@aht</p>
                        <p class="period-card__note">@Leader(hht, aht)</p>
                    </article>
                    <article class="period-card">
                        <p class="period-card__label">İkinci yarı</p>
                        <p class="period-card__score">@(hg - hht)-@(ag - aht)</p>
                        <p class="period-card__note">@Leader(hg - hht, ag - aht)</p>
                    </article>
                    <article class="period-card period-card--final">
                        <p class="period-card__label">Sonuç</p>
                        <p class="period-card__score">@hg-@ag</p>
                        <p class="period-card__note">@(hg == ag ? "Berabere" : (hg > ag ? home.Name : away.Name) + " kazandı")</p>
                    </article>
                </div>

                <section class="panel" aria-labelledby="stats-title">
                    <div class="panel__head">
                        <h2 class="panel__title" id="stats-title">İstatistikler</h2>
                        <div class="stats-teams" aria-hidden="true">
                            <span><span class="team-crest team-crest--xs @home.Css">@home.Abbr</span>@home.Name</span>
                            <span>@away.Name<span class="team-crest team-crest--xs @away.Css">@away.Abbr</span></span>
                        </div>
                    </div>

                    <div class="possession">
                        <div class="possession__row">
                            <span class="possession__value">%@possHome</span>
                            <span class="possession__label">Topa sahip olma</span>
                            <span class="possession__value possession__value--away">%@possAway</span>
                        </div>
                        <div class="possession__bar" aria-hidden="true">
                            <span style="flex:@possHome;background:var(--home)"></span>
                            <span style="flex:@possAway;background:var(--away)"></span>
                        </div>
                    </div>

                    <ul class="stat-list">
                        @foreach (var s in stats)
                        {
                            <li class="stat-row @(s.Muted ? "stat-row--muted" : "")">
                                <div class="stat-row__values">
                                    <span class="stat-val @(s.Home > s.Away ? "is-lead" : "")">@s.HomeText</span>
                                    <span class="stat-row__label">@s.Label</span>
                                    <span class="stat-val stat-val--away @(s.Away > s.Home ? "is-lead" : "")">@s.AwayText</span>
                                </div>
                                <div class="stat-bar" aria-hidden="true">
                                    <span class="bar-home" style="--w:@Pct(s.Home, s.Away, true)"></span>
                                    <span class="bar-away" style="--w:@Pct(s.Home, s.Away, false)"></span>
                                </div>
                            </li>
                        }
                    </ul>
                </section>

                <section class="panel" aria-labelledby="info-title">
                    <div class="panel__head"><h2 class="panel__title" id="info-title">Maç bilgileri</h2></div>
                    <dl class="info-list">
                        <div><dt>Lig</dt><dd>Serie A</dd></div>
                        <div><dt>Sezon</dt><dd>2026/27</dd></div>
                        <div><dt>Hafta</dt><dd>12</dd></div>
                        <div><dt>Stadyum</dt><dd>@stadium</dd></div>
                        <div><dt>Şehir</dt><dd>Milano, İtalya</dd></div>
                        <div><dt>Hakem</dt><dd>@referee</dd></div>
                        <div><dt>Seyirci</dt><dd>@attendance</dd></div>
                        <div><dt>Tarih</dt><dd>@date</dd></div>
                        <div><dt>Saat</dt><dd>@time</dd></div>
                    </dl>
                </section>
            </aside>
        </div>
    </div>

    <p class="page-note">Sayfadaki veriler demo amaçlıdır.</p>
</main>

@section Scripts {
    <script src="~/js/match-detail.js" asp-append-version="true"></script>
}

@functions {
    private record Team(string Side, string Name, string Abbr, string Css);
    private record Ev(int Min, string Label, string Side, string Kind, string Player, string Meta, string Assist = "");
    private record Stat(string Label, double Home, double Away, string HomeText, string AwayText, bool Muted);
}
